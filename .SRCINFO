	optdepends = quickshell: Native desktop shader transition animations (end-4 dots / illogical-impulse)
	optdepends = swww: Wayland wallpaper daemon with animated transitions
	optdepends = hyprpaper: Official Hyprland wallpaper daemon
	optdepends = mpvpaper: Animated and video wallpaper support
	optdepends = kitty: Inline terminal preview with Kitty graphics protocol
	optdepends = libnotify: Desktop notifications via notify-send
	optdepends = matugen: Dynamic Material You palette regeneration
	provides = rice-gen
	conflicts = rice-gen
	options = !lto

pkgname = rice-gen

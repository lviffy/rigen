pkgbase = rice-gen
	pkgdesc = AI-powered palette-synchronized wallpaper generator for Hyprland & Linux
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/lviffy/rice-gen
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	depends = gcc-libs
